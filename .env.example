# Endereço do Ecos CRM. "Entrar" leva a <CRM_URL>/login e, com o cadastro
# aberto, "Criar conta" leva a <CRM_URL>/register.
CRM_URL=http://localhost:3100

# "true" só depois do lançamento. Fechado, a página /entrar mostra o cadastro
# como "em breve" e manda para a lista do workshop.
CADASTRO_ABERTO=false

# Endereço da Academy. Vazio, /academy mostra a página de "em preparação".
ACADEMY_URL=http://localhost:3000

# Banco das inscrições do workshop. Vazio, o formulário responde que a
# inscrição está indisponível, em vez de fingir que registrou.
DATABASE_URL=
